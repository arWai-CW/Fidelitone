{
  "manifest_version": 3,
  "name": "Fidelitone",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "description": "Real-time audio pitch transposition for Chrome tabs",
  "permissions": ["tabCapture", "offscreen", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fidelitone"
  }
}
